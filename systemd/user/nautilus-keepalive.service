[Unit]
Description=Nautilus keepalive — держит тёплый демон, чтобы окна после простоя открывались сразу (иначе холодный старт, медленно с Papirus)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/scripts/nautilus-keepalive.py
ExecStop=-/usr/bin/nautilus --quit
Restart=always
RestartSec=5
StandardOutput=null

[Install]
WantedBy=graphical-session.target
