animations {
    workspace-switch {
        duration-ms 340
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }

    horizontal-view-movement {
        spring damping-ratio=0.95 stiffness=600 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.93 stiffness=560 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.92 stiffness=540 epsilon=0.0001
    }

    window-open {
        duration-ms 320
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    config-notification-open-close {
        spring damping-ratio=0.75 stiffness=700 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 280
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }

    overview-open-close {
        spring damping-ratio=0.94 stiffness=600 epsilon=0.0001
    }
}
