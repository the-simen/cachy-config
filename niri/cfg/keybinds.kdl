binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── noctalia keybinds ───
    // https://docs.noctalia.dev/getting-started/keybinds/
    Mod+CTRL+Shift+L                    hotkey-overlay-title="Change caps-ctrl layout" { spawn-sh "$HOME/.config/scripts/change_layout.sh"; }

    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Open Terminal: Kitty" { spawn "kitty"; }
    Mod+ALT+Return                      hotkey-overlay-title="Open Terminal Multiplexer: TMUX" { spawn-sh "kitty --title 'TMUX' fish -c 'tm'"; }
    Mod+B                               hotkey-overlay-title="Open Browser: Zen" { spawn "zen-browser"; }
    Mod+Shift+B                         hotkey-overlay-title="Open Browser: Zen" { spawn-sh "zen-browser --private-window"; }
    Mod+R                               hotkey-overlay-title="Switch column width preset" { switch-preset-column-width; }
    // Please choose your own file manager.
    Mod+E                               hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }
    Mod+M                               hotkey-overlay-title="Spotify" { spawn "spotify"; }

    // ─── Core Noctralia keybinds ───
    // Alt+Tab                             { spawn-sh "noctalia msg window-switcher"; }
    Mod+CTRL+ALT+L                      hotkey-overlay-title="Lock Screen: noctalia lock" { spawn-sh "noctalia msg session lock"; }
    Mod+CTRL+Return                     hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+ESCAPE                          hotkey-overlay-title="Toggle session panel" { spawn-sh "noctalia msg panel-toggle session"; }

    // ─── Screenshots ───
    CTRL+Shift+1                        hotkey-overlay-title="Screenshot region" { spawn-sh "noctalia msg screenshot-region"; }
    CTRL+Shift+2                        hotkey-overlay-title="Screenshot fullscreen" { spawn-sh "noctalia msg screenshot-fullscreen"; }
    CTRL+Shift+3                        hotkey-overlay-title="Screenshot annotate" { spawn-sh "noctalia msg screenshot-annotate"; }

    // Audio & Brightness
    XF86AudioRaiseVolume                hotkey-overlay-title="Volume up" { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                hotkey-overlay-title="Volume down" { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       hotkey-overlay-title="Volume mute" { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp                 hotkey-overlay-title="Brightness up" { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               hotkey-overlay-title="Brightness down" { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───
    Mod+ALT+H                           hotkey-overlay-title="Move window to left column" { consume-or-expel-window-left; }
    Mod+ALT+L                           hotkey-overlay-title="Move window to right column" { consume-or-expel-window-right; }
                                       
    Mod+ALT+Left                        hotkey-overlay-title="Move window to left column" { consume-or-expel-window-left; }
    Mod+ALT+Right                       hotkey-overlay-title="Move window to right column" { consume-or-expel-window-right; }

    Mod+Q                               hotkey-overlay-title="Close window" { close-window; }

    Mod+Left                            hotkey-overlay-title="Focus column to the left" { focus-column-left; }
    Mod+H                               hotkey-overlay-title="Focus column to the left" { focus-column-left; }
    Mod+Right                           hotkey-overlay-title="Focus column to the right" { focus-column-right; }
    Mod+L                               hotkey-overlay-title="Focus column to the right" { focus-column-right; }
    Mod+Alt+Up                          hotkey-overlay-title="Focus window above inside column" { focus-window-up; }
    Mod+Alt+K                           hotkey-overlay-title="Focus window above inside column" { focus-window-up; }
    Mod+Alt+Down                        hotkey-overlay-title="Focus window below inside column" { focus-window-down; }
    Mod+Alt+J                           hotkey-overlay-title="Focus window below inside column" { focus-window-down; }
    Mod+Up                              hotkey-overlay-title="Focus workspace above" { focus-workspace-up; }
    Mod+K                               hotkey-overlay-title="Focus workspace above" { focus-workspace-up; }
    Mod+Down                            hotkey-overlay-title="Focus workspace below" { focus-workspace-down; }
    Mod+J                               hotkey-overlay-title="Focus workspace below" { focus-workspace-down; }

    Mod+CTRL+Left                       hotkey-overlay-title="Move column to the left" { move-column-left; }
    Mod+CTRL+H                          hotkey-overlay-title="Move column to the left" { move-column-left; }
    Mod+CTRL+Down                       hotkey-overlay-title="Move column to the bottom workspace" { move-column-to-workspace-down; }
    Mod+CTRL+J                          hotkey-overlay-title="Move column to the bottom workspace" { move-column-to-workspace-down; }
    Mod+CTRL+Right                      hotkey-overlay-title="Move column to the right" { move-column-right; }
    Mod+CTRL+L                          hotkey-overlay-title="Move column to the right" { move-column-right; }
    Mod+CTRL+UP                         hotkey-overlay-title="Move column to the top workspace" { move-column-to-workspace-up; }
    Mod+CTRL+K                          hotkey-overlay-title="Move column to the top workspace" { move-column-to-workspace-up; }
    Mod+Alt+CTRL+Down                   hotkey-overlay-title="Move window to the bottom inside column" { move-window-down; }
    Mod+Alt+CTRL+J                      hotkey-overlay-title="Move window to the bottom inside column" { move-window-down; }
    Mod+Alt+CTRL+UP                     hotkey-overlay-title="Move window to the top inside column" { move-window-up; }
    Mod+Alt+CTRL+K                      hotkey-overlay-title="Move window to the top inside column" { move-window-up; }

    Mod+Home                            hotkey-overlay-title="Focus column to the first" { focus-column-first; }
    Mod+End                             hotkey-overlay-title="Focus column to the last" { focus-column-last; }
    Mod+CTRL+Home                       hotkey-overlay-title="Move column to the first" { move-column-to-first; }
    Mod+CTRL+End                        hotkey-overlay-title="Move column to the last" { move-column-to-last; }

    Mod+Shift+Left                      hotkey-overlay-title="Focus monitor to the left" { focus-monitor-left; }
    Mod+Shift+H                         hotkey-overlay-title="Focus monitor to the left" { focus-monitor-left; }
    Mod+Shift+Right                     hotkey-overlay-title="Focus monitor to the right" { focus-monitor-right; }
    Mod+Shift+L                         hotkey-overlay-title="Focus monitor to the right" { focus-monitor-right; }
    Mod+Shift+UP                        hotkey-overlay-title="Focus monitor to the top" { focus-monitor-up; }
    Mod+Shift+K                         hotkey-overlay-title="Focus monitor to the top" { focus-monitor-up; }
    Mod+Shift+Down                      hotkey-overlay-title="Focus monitor to the bottom" { focus-monitor-down; }                
    Mod+Shift+J                         hotkey-overlay-title="Focus monitor to the bottom" { focus-monitor-down; }

    Mod+Shift+CTRL+Left                 hotkey-overlay-title="Move column to the left" { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                hotkey-overlay-title="Move column to the right" { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   hotkey-overlay-title="Move column to the top" { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 hotkey-overlay-title="Move column to the bottom" { move-column-to-monitor-down; }

    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 hotkey-overlay-title="Focus workspace down" cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   hotkey-overlay-title="Focus workspace up" cooldown-ms=150 { focus-workspace-up; }
    Mod+CTRL+WheelScrollDown            hotkey-overlay-title="Move column to the right" cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              hotkey-overlay-title="Move column to the top workspace" cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                hotkey-overlay-title="Focus column to the right" { focus-column-right; }
    Mod+WheelScrollLeft                 hotkey-overlay-title="Focus column to the left" { focus-column-left; }
    Mod+CTRL+WheelScrollRight           hotkey-overlay-title="Move column to the right" { move-column-right; }
    Mod+CTRL+WheelScrollLeft            hotkey-overlay-title="Move column to the left" { move-column-left; }

    Mod+Shift+WheelScrollDown           hotkey-overlay-title="Focus column to the right" { focus-column-right; }
    Mod+Shift+WheelScrollUp             hotkey-overlay-title="Focus column to the left" { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      hotkey-overlay-title="Move column to the right" { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        hotkey-overlay-title="Move column to the left" { move-column-left; }

    Mod+1                               hotkey-overlay-title="Focus workspace 1" { focus-workspace 1; }
    Mod+2                               hotkey-overlay-title="Focus workspace 2" { focus-workspace 2; }
    Mod+3                               hotkey-overlay-title="Focus workspace 3" { focus-workspace 3; }
    Mod+4                               hotkey-overlay-title="Focus workspace 4" { focus-workspace 4; }
    Mod+5                               hotkey-overlay-title="Focus workspace 5" { focus-workspace 5; }
    Mod+6                               hotkey-overlay-title="Focus workspace 6" { focus-workspace 6; }
    Mod+7                               hotkey-overlay-title="Focus workspace 7" { focus-workspace 7; }
    Mod+8                               hotkey-overlay-title="Focus workspace 8" { focus-workspace 8; }
    Mod+9                               hotkey-overlay-title="Focus workspace 9" { focus-workspace 9; }

    Mod+CTRL+1                          hotkey-overlay-title="Move column to workspace 1" { move-column-to-workspace 1; }
    Mod+CTRL+2                          hotkey-overlay-title="Move column to workspace 2" { move-column-to-workspace 2; }
    Mod+CTRL+3                          hotkey-overlay-title="Move column to workspace 3" { move-column-to-workspace 3; }
    Mod+CTRL+4                          hotkey-overlay-title="Move column to workspace 4" { move-column-to-workspace 4; }
    Mod+CTRL+5                          hotkey-overlay-title="Move column to workspace 5" { move-column-to-workspace 5; }
    Mod+CTRL+6                          hotkey-overlay-title="Move column to workspace 6" { move-column-to-workspace 6; }
    Mod+CTRL+7                          hotkey-overlay-title="Move column to workspace 7" { move-column-to-workspace 7; }
    Mod+CTRL+8                          hotkey-overlay-title="Move column to workspace 8" { move-column-to-workspace 8; }
    Mod+CTRL+9                          hotkey-overlay-title="Move column to workspace 9" { move-column-to-workspace 9; }

    // Mod+TAB                             { focus-workspace-previous; }

    // ─── Layout Controls ───
    Mod+CTRL+F                          hotkey-overlay-title="Expand column to available width" { expand-column-to-available-width; }
    Mod+C                               hotkey-overlay-title="Center column" { center-column; }
    Mod+CTRL+C                          hotkey-overlay-title="Center visible columns" { center-visible-columns; }
    Mod+Minus                           hotkey-overlay-title="Set column width to -10%" { set-column-width "-10%"; }
    Mod+Equal                           hotkey-overlay-title="Set column width to +10%" { set-column-width "+10%"; }
    Mod+Shift+Minus                     hotkey-overlay-title="Set window height to -10%" { set-window-height "-10%"; }
    Mod+Shift+Equal                     hotkey-overlay-title="Set window height to +10%" { set-window-height "+10%"; }

    // ─── Modes ───
    Mod+T                               hotkey-overlay-title="Toggle window floating" { toggle-window-floating; }
    Mod+F                               hotkey-overlay-title="Fullscreen window" { fullscreen-window; }
    Mod+W                               hotkey-overlay-title="Toggle column tabbed display" { toggle-column-tabbed-display; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    // Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     hotkey-overlay-title="Quit" { quit; } // Also quits Niri
    Mod+Shift+P                         hotkey-overlay-title="Power off monitors" { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    Mod+O                               hotkey-overlay-title="Toggle overview" repeat=false { toggle-overview; }
    Mod+TAB                             hotkey-overlay-title="Toggle overview" repeat=false { toggle-overview; }
}
