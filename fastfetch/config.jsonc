{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logos/ascii/kanji_wttfw",
    "color": {
      "1": "red"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "key": "ホスト",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "key": "╭─System─────╮",
      "keyColor": "green"
    },
    {
      "type": "os",
      "key": "│  OS       │",
      "format": "{pretty-name}",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "│  Kernel   │",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "│ 󰮯 Pacman   │",
      "format": "{pacman} packages",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "│ 󰏗 Flatpak  │",
      "format": "{flatpak-all} packages",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "│  DE       │",
      "format": "{pretty-name} {version}",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "│ 󰧨 WM       │",
      "format": "{pretty-name} {version}",
      "keyColor": "green"
    },
    {
      "type": "lm",
      "key": "│ 󰍂 LM       │",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "├─Terminal───┤",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "│  Emulator │",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "│ 󰈺 Shell    │",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "│  Font     │",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "╰────────────╯",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "╭─Hardware",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "├─󰍛",
      "format": "{name}",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "├─󰘚",
      "format": "{name}",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "├─󰍹",
      "format": "{inch}\" {width}x{height}, {refresh-rate}Hz",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "├─󰑭",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "╰─󰅐",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "key": "╭─────────────────────────╮",
      "keyColor": "\u001b[30m"
    },
    {
      "type": "custom",
      "keyColor": "blue",
      "format": "\u001b[30m│ \u001b[1m\u001b[31m  \u001b[1m\u001b[32m  \u001b[1m\u001b[33m  \u001b[1m\u001b[34m  \u001b[1m\u001b[35m  \u001b[1m\u001b[36m  \u001b[1m\u001b[37m  \u001b[1m\u001b[30m  \u001b[30m│"
    },
    {
      "type": "custom",
      "key": "╰─────────────────────────╯",
      "keyColor": "\u001b[30m"
    }
  ]
}
