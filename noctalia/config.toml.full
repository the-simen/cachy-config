    color = ""
    credential_source = "secret-service"
    name = "Google calendar"
    password_file = ""
    path = ""
    provider = ""
    server_url = ""
    type = "google"
    username = ""

    [calendar.reminders]
    all_day_digest_time = "09:00"
    default_lead_minutes = 10
    enabled = true
    use_event_reminders = true

