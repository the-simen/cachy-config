[battery]
warning_threshold = 10

[brightness]
enable_ddcutil = false
ignore_mmids = []
minimum_brightness = 0.0
sync_all_monitors = false

[calendar]
enabled = true
event_date_format = "%A %e %B"
event_time_format = "%H:%M"
refresh_minutes = 15

    [calendar.account.personal_google]
